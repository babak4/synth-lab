[
  {
    "schemaVersion": 1,
    "id": "init",
    "name": "Init",
    "description": "One sawtooth, filter wide open, plain envelope. The starting point for building any sound.",
    "teaches": "oscillators",
    "patch": {
      "schemaVersion": 1,
      "name": "Init",
      "params": {}
    },
    "auditionPitch": 57
  },
  {
    "schemaVersion": 1,
    "id": "plucked-bass",
    "name": "Plucked Bass",
    "description": "The filter envelope opens the filter on every note and closes it again fast: the pluck is the filter moving, not the volume.",
    "teaches": "envelopes",
    "patch": {
      "schemaVersion": 1,
      "name": "Plucked Bass",
      "params": {
        "mix-osc-a": 0.8,
        "sub-waveform": "square",
        "sub-octave": -1,
        "mix-sub": 0.5,
        "filter-cutoff": 180,
        "filter-resonance": 4,
        "filter-env-amount": 0.75,
        "filter-env-attack": 0.001,
        "filter-env-decay": 0.22,
        "filter-env-sustain": 0,
        "filter-env-release": 0.15,
        "filter-env-velocity": 0.5,
        "amp-env-attack": 0.002,
        "amp-env-decay": 0.4,
        "amp-env-sustain": 0.4,
        "amp-env-release": 0.12,
        "voice-mode": "mono",
        "voice-glide": 0.03
      }
    },
    "auditionPitch": 40
  },
  {
    "schemaVersion": 1,
    "id": "warm-pad",
    "name": "Warm Pad",
    "description": "A slow attack and a long release make the sound swell in and fade out instead of starting and stopping.",
    "teaches": "amp-env-attack",
    "patch": {
      "schemaVersion": 1,
      "name": "Warm Pad",
      "params": {
        "osc-b-waveform": "sawtooth",
        "osc-b-fine": 9,
        "mix-osc-a": 0.6,
        "mix-osc-b": 0.6,
        "filter-cutoff": 1400,
        "filter-resonance": 1.2,
        "filter-env-amount": 0.3,
        "filter-env-attack": 1.2,
        "filter-env-decay": 1.5,
        "filter-env-sustain": 0.6,
        "filter-env-release": 1.5,
        "amp-env-attack": 0.9,
        "amp-env-decay": 0.5,
        "amp-env-sustain": 0.85,
        "amp-env-release": 1.6,
        "reverb-on": true,
        "reverb-size": "hall",
        "reverb-mix": 0.35
      }
    },
    "auditionPitch": 60
  },
  {
    "schemaVersion": 1,
    "id": "vibrato-lead",
    "name": "Vibrato Lead",
    "description": "A slow LFO nudges the pitch up and down about five times a second, like a singer or violinist adding vibrato.",
    "teaches": "lfo-destination",
    "patch": {
      "schemaVersion": 1,
      "name": "Vibrato Lead",
      "params": {
        "osc-b-waveform": "square",
        "osc-b-fine": -7,
        "mix-osc-a": 0.7,
        "mix-osc-b": 0.35,
        "filter-cutoff": 4500,
        "filter-resonance": 2,
        "amp-env-attack": 0.008,
        "amp-env-decay": 0.2,
        "amp-env-sustain": 0.85,
        "amp-env-release": 0.25,
        "lfo-shape": "sine",
        "lfo-rate": 5.5,
        "lfo-depth": 0.18,
        "lfo-destination": "pitch",
        "voice-mode": "legato",
        "voice-glide": 0.08,
        "delay-on": true,
        "delay-time": 0.32,
        "delay-feedback": 0.3,
        "delay-mix": 0.2
      }
    },
    "auditionPitch": 72
  },
  {
    "schemaVersion": 1,
    "id": "wobble-bass",
    "name": "Wobble Bass",
    "description": "An LFO locked to the tempo sweeps the filter up and down in time with the music: the classic dubstep wobble.",
    "teaches": "lfo-sync",
    "patch": {
      "schemaVersion": 1,
      "name": "Wobble Bass",
      "params": {
        "mix-osc-a": 0.4,
        "sub-waveform": "sine",
        "sub-octave": -1,
        "mix-sub": 0.3,
        "filter-cutoff": 220,
        "filter-resonance": 8,
        "lfo-shape": "sine",
        "lfo-sync": true,
        "lfo-division": "1/8",
        "lfo-depth": 0.55,
        "lfo-destination": "cutoff",
        "lfo-retrigger": true,
        "amp-env-attack": 0.005,
        "amp-env-decay": 0.2,
        "amp-env-sustain": 0.9,
        "amp-env-release": 0.15,
        "voice-mode": "mono",
        "dist-on": true,
        "dist-drive": 18,
        "dist-tone": 6000,
        "dist-mix": 0.35
      }
    },
    "auditionPitch": 36
  },
  {
    "schemaVersion": 1,
    "id": "pwm-strings",
    "name": "PWM Strings",
    "description": "Pulse waves whose width is swept by a slow LFO. The constantly changing shape gives a rich, moving string-like sound.",
    "teaches": "osc-a-pulse-width",
    "patch": {
      "schemaVersion": 1,
      "name": "PWM Strings",
      "params": {
        "osc-a-waveform": "pulse",
        "osc-b-waveform": "pulse",
        "osc-b-fine": 8,
        "mix-osc-a": 0.32,
        "mix-osc-b": 0.32,
        "filter-cutoff": 3000,
        "filter-resonance": 0.8,
        "lfo-shape": "sine",
        "lfo-rate": 0.6,
        "lfo-depth": 0.8,
        "lfo-destination": "pulse-width",
        "amp-env-attack": 0.35,
        "amp-env-decay": 0.3,
        "amp-env-sustain": 0.9,
        "amp-env-release": 0.8,
        "reverb-on": true,
        "reverb-size": "room",
        "reverb-mix": 0.3
      }
    },
    "auditionPitch": 60
  },
  {
    "schemaVersion": 1,
    "id": "supersaw-lead",
    "name": "Supersaw Lead",
    "description": "Two sawtooths detuned slightly apart (and a sub below) sound much bigger than one. Detuning is how synths make a thick lead.",
    "teaches": "oscillators",
    "patch": {
      "schemaVersion": 1,
      "name": "Supersaw Lead",
      "params": {
        "osc-a-fine": -14,
        "osc-b-waveform": "sawtooth",
        "osc-b-fine": 14,
        "mix-osc-a": 0.7,
        "mix-osc-b": 0.7,
        "sub-waveform": "square",
        "sub-octave": -1,
        "mix-sub": 0.25,
        "filter-cutoff": 6000,
        "filter-resonance": 1.5,
        "amp-env-attack": 0.012,
        "amp-env-decay": 0.2,
        "amp-env-sustain": 0.8,
        "amp-env-release": 0.35,
        "delay-on": true,
        "delay-sync": true,
        "delay-division": "1/8",
        "delay-pingpong": true,
        "delay-feedback": 0.4,
        "delay-mix": 0.25,
        "reverb-on": true,
        "reverb-size": "short",
        "reverb-mix": 0.15
      }
    },
    "auditionPitch": 67
  },
  {
    "schemaVersion": 1,
    "id": "organ",
    "name": "Organ",
    "description": "Three sine waves an octave apart add up to a new tone. An organ builds sounds by layering harmonics exactly like this.",
    "teaches": "mixer",
    "patch": {
      "schemaVersion": 1,
      "name": "Organ",
      "params": {
        "osc-a-waveform": "sine",
        "osc-b-waveform": "sine",
        "osc-b-octave": 1,
        "sub-waveform": "sine",
        "sub-octave": -1,
        "mix-osc-a": 0.32,
        "mix-osc-b": 0.22,
        "mix-sub": 0.24,
        "filter-cutoff": 12000,
        "amp-env-attack": 0.004,
        "amp-env-decay": 0.05,
        "amp-env-sustain": 1,
        "amp-env-release": 0.06,
        "amp-env-velocity": 0,
        "reverb-on": true,
        "reverb-size": "room",
        "reverb-mix": 0.15
      }
    },
    "auditionPitch": 60
  },
  {
    "schemaVersion": 1,
    "id": "beating-sines",
    "name": "Beating Sines",
    "description": "Two sine waves a few cents apart drift in and out of phase, so the volume pulses slowly. This pulsing is called beating.",
    "teaches": "osc-b-fine",
    "patch": {
      "schemaVersion": 1,
      "name": "Beating Sines",
      "params": {
        "osc-a-waveform": "sine",
        "osc-b-waveform": "sine",
        "osc-b-fine": 6,
        "mix-osc-a": 0.27,
        "mix-osc-b": 0.27,
        "filter-cutoff": 12000,
        "amp-env-attack": 0.15,
        "amp-env-sustain": 1,
        "amp-env-release": 0.8,
        "reverb-on": true,
        "reverb-size": "hall",
        "reverb-mix": 0.3
      }
    },
    "auditionPitch": 60
  },
  {
    "schemaVersion": 1,
    "id": "acid-squelch",
    "name": "Acid Squelch",
    "description": "High resonance boosts the frequencies right at the cutoff. Sweeping it with an envelope gives the squelchy, vocal acid-bass sound.",
    "teaches": "filter-resonance",
    "patch": {
      "schemaVersion": 1,
      "name": "Acid Squelch",
      "params": {
        "mix-osc-a": 0.5,
        "filter-cutoff": 350,
        "filter-resonance": 14,
        "filter-env-amount": 0.7,
        "filter-key-tracking": 0.5,
        "filter-env-attack": 0.002,
        "filter-env-decay": 0.22,
        "filter-env-sustain": 0,
        "filter-env-release": 0.1,
        "amp-env-attack": 0.003,
        "amp-env-decay": 0.2,
        "amp-env-sustain": 0.8,
        "amp-env-release": 0.1,
        "voice-mode": "mono",
        "voice-glide": 0.07,
        "dist-on": true,
        "dist-drive": 14,
        "dist-mix": 0.4
      }
    },
    "auditionPitch": 38
  },
  {
    "schemaVersion": 1,
    "id": "tremolo-keys",
    "name": "Tremolo Keys",
    "description": "An LFO aimed at the volume makes it swell and fade rhythmically. That pulsing level is tremolo, the cousin of vibrato.",
    "teaches": "lfo",
    "patch": {
      "schemaVersion": 1,
      "name": "Tremolo Keys",
      "params": {
        "osc-a-waveform": "triangle",
        "osc-b-waveform": "sine",
        "osc-b-octave": 1,
        "mix-osc-a": 1.0,
        "mix-osc-b": 0.4,
        "filter-cutoff": 5000,
        "amp-env-attack": 0.003,
        "amp-env-decay": 1.2,
        "amp-env-sustain": 0.5,
        "amp-env-release": 0.5,
        "amp-env-velocity": 0.8,
        "lfo-shape": "sine",
        "lfo-rate": 5,
        "lfo-depth": 0.45,
        "lfo-destination": "amp",
        "reverb-on": true,
        "reverb-size": "room",
        "reverb-mix": 0.2
      }
    },
    "auditionPitch": 64
  },
  {
    "schemaVersion": 1,
    "id": "ping-pong-pluck",
    "name": "Ping-Pong Pluck",
    "description": "Short plucked notes feed a delay that bounces the echoes between the left and right speakers.",
    "teaches": "delay-pingpong",
    "patch": {
      "schemaVersion": 1,
      "name": "Ping-Pong Pluck",
      "params": {
        "osc-a-waveform": "square",
        "mix-osc-a": 1.0,
        "filter-cutoff": 4000,
        "filter-resonance": 2,
        "filter-env-amount": 0.4,
        "filter-env-attack": 0.001,
        "filter-env-decay": 0.15,
        "filter-env-sustain": 0,
        "filter-env-release": 0.1,
        "amp-env-attack": 0.002,
        "amp-env-decay": 0.3,
        "amp-env-sustain": 0,
        "amp-env-release": 0.1,
        "delay-on": true,
        "delay-sync": true,
        "delay-division": "1/8",
        "delay-pingpong": true,
        "delay-feedback": 0.6,
        "delay-mix": 0.45,
        "reverb-on": true,
        "reverb-size": "short",
        "reverb-mix": 0.15
      }
    },
    "auditionPitch": 69
  },
  {
    "schemaVersion": 1,
    "id": "wind-sweep",
    "name": "Wind Sweep",
    "description": "Noise instead of an oscillator, shaped by a band-pass filter that slowly sweeps: there is no pitch, just a moving band of sound.",
    "teaches": "filter-type",
    "patch": {
      "schemaVersion": 1,
      "name": "Wind Sweep",
      "params": {
        "mix-osc-a": 0,
        "mix-noise": 1.0,
        "filter-type": "bandpass",
        "filter-cutoff": 600,
        "filter-resonance": 3,
        "filter-env-amount": 0.8,
        "filter-env-attack": 1.8,
        "filter-env-decay": 2,
        "filter-env-sustain": 0.2,
        "filter-env-release": 1.5,
        "amp-env-attack": 1.2,
        "amp-env-sustain": 1.0,
        "amp-env-release": 2,
        "lfo-shape": "sine",
        "lfo-rate": 0.2,
        "lfo-depth": 0.2,
        "lfo-destination": "cutoff",
        "reverb-on": true,
        "reverb-size": "hall",
        "reverb-mix": 0.4
      }
    },
    "auditionPitch": 48
  }
]
